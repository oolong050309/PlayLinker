{
  "info": {
    "name": "PlayLinker API - 开发者A",
    "description": "PlayLinker 统一游戏管理平台 - 用户认证、用户管理、平台绑定、通知中心、家长监管",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "认证模块",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player123\",\n  \"password\": \"SecurePass123!\",\n  \"email\": \"player@example.com\",\n  \"phone\": \"13800138000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player123\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "刷新Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allDevices\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "忘记密码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"player@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        }
      ]
    },
    {
      "name": "用户管理模块",
      "item": [
        {
          "name": "获取个人信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "更新个人信息",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new@example.com\",\n  \"phone\": \"13900139000\",\n  \"gender\": 1,\n  \"avatarUrl\": \"https://new-avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "修改密码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"SecurePass123!\",\n  \"newPassword\": \"NewPass456!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/change-password",
              "host": ["{{base_url}}"],
              "path": ["users", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "平台绑定模块",
      "item": [
        {
          "name": "获取OAuth URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/platforms/oauth/steam",
              "host": ["{{base_url}}"],
              "path": ["platforms", "oauth", "steam"]
            }
          }
        },
        {
          "name": "绑定平台",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platformId\": 1,\n  \"authCode\": \"oauth_code_xyz\",\n  \"state\": \"random_state_abc123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/platforms/bind",
              "host": ["{{base_url}}"],
              "path": ["platforms", "bind"]
            }
          }
        },
        {
          "name": "获取绑定列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/platforms/bindings",
              "host": ["{{base_url}}"],
              "path": ["platforms", "bindings"]
            }
          }
        },
        {
          "name": "解绑平台",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/platforms/bindings/1",
              "host": ["{{base_url}}"],
              "path": ["platforms", "bindings", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "通知中心模块",
      "item": [
        {
          "name": "获取通知列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "isRead",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "info",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "标记通知为已读",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/1/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "1", "read"]
            }
          }
        },
        {
          "name": "删除通知",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/1",
              "host": ["{{base_url}}"],
              "path": ["notifications", "1"]
            }
          }
        },
        {
          "name": "通知订阅设置",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceAlert\": {\n    \"enabled\": true,\n    \"email\": true,\n    \"push\": true\n  },\n  \"parentalControl\": {\n    \"enabled\": true,\n    \"email\": true,\n    \"push\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/notifications/subscribe",
              "host": ["{{base_url}}"],
              "path": ["notifications", "subscribe"]
            }
          }
        }
      ]
    },
    {
      "name": "家长监管模块",
      "item": [
        {
          "name": "创建监管关系",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childUserId\": 1002\n}"
            },
            "url": {
              "raw": "{{base_url}}/parental/relationships",
              "host": ["{{base_url}}"],
              "path": ["parental", "relationships"]
            }
          }
        },
        {
          "name": "获取子账户列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/parental/children",
              "host": ["{{base_url}}"],
              "path": ["parental", "children"]
            }
          }
        },
        {
          "name": "设置监管规则",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childUserId\": 1002,\n  \"ruleType\": \"playtime_daily_limit\",\n  \"ruleValue\": {\n    \"limitMinutes\": 120,\n    \"warningMinutes\": 100\n  },\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/parental/rules",
              "host": ["{{base_url}}"],
              "path": ["parental", "rules"]
            }
          }
        },
        {
          "name": "获取规则列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/parental/rules/1002",
              "host": ["{{base_url}}"],
              "path": ["parental", "rules", "1002"]
            }
          }
        },
        {
          "name": "获取违规记录",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/parental/alerts?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["parental", "alerts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "childId",
                  "value": "1002",
                  "disabled": true
                },
                {
                  "key": "ruleType",
                  "value": "playtime_daily_limit",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ]
}

